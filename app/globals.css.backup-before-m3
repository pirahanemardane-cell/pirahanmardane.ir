/* === CHECKOUT STICKY HARD (final override) === */
.checkout-page-shell,
.checkout-page-shell *,
.cart-page-shell,
.cart-page-shell * {
  /* do not set overflow:hidden on ancestors of sticky */
}
.checkout-page-shell,
.cart-page-shell {
  overflow: visible !important;
}
@media (min-width: 1024px) {
  /* cart: sticky on the aside itself */
  aside.order-summary-col:not(.checkout-summary-col) {
    position: -webkit-sticky !important;
    position: sticky !important;
    top: calc(var(--site-header-h, 6.75rem) + 0.75rem) !important;
    align-self: flex-start !important;
    z-index: 40 !important;
  }
  /* checkout: sticky is on the inner panel; column stretches full height */
  aside.checkout-summary-col.order-summary-col {
    position: relative !important;
    align-self: stretch !important;
    top: auto !important;
    z-index: 30 !important;
  }
}


/* === CHECKOUT LAYOUT STICKY DEFINITIVE === */
.checkout-page-shell,
.checkout-page-shell > div {
  overflow: visible !important;
}
.checkout-grid-layout {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 1.5rem;
  width: 100%;
}
.checkout-main-col {
  width: 100%;
  min-width: 0;
}
.checkout-summary-col {
  width: 100%;
}
@media (min-width: 1024px) {
  .checkout-grid-layout {
    display: grid !important;
    /* در RTL: ستون ۱ از راست شروع می‌شود → فرم راست، خلاصه چپ (مثل سبد) */
    grid-template-columns: minmax(0, 1fr) 320px !important;
    align-items: stretch !important;
    column-gap: 1.5rem !important;
    row-gap: 0 !important;
    width: 100% !important;
  }
  /* خلاصه = ستون چپ (col 2 در RTL) — ستون کشیده تا sticky تا قبل فوتر جا داشته باشد */
  .checkout-grid-layout > .checkout-summary-col {
    grid-column: 2 !important;
    grid-row: 1 !important;
    width: 320px !important;
    max-width: 320px !important;
    position: relative !important;
    align-self: stretch !important;
    z-index: 30 !important;
    height: auto !important;
    min-height: 100% !important;
    overflow: visible !important;
  }
  .checkout-grid-layout > .checkout-main-col {
    grid-column: 1 !important;
    grid-row: 1 !important;
    min-width: 0 !important;
    width: auto !important;
    max-width: 100% !important;
  }
  /* پنل خلاصه سفارش: چسبان عمودی داخل ستون چپ تا قبل فوتر */
  .checkout-summary-panel {
    position: -webkit-sticky !important;
    position: sticky !important;
    top: calc(var(--site-header-h, 6.75rem) + 0.75rem) !important;
    width: 100% !important;
    overflow: visible !important;
    z-index: 30 !important;
  }
}


/* === header auth overflow guard === */
/* فقط نوار ورود هدر — جلوگیری از بیرون‌زدن وقتی لاگین است */
header .header-auth,
header [data-header-auth],
.site-header .header-auth {
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
  display: flex;
  flex-wrap: nowrap;
  align-items: center;
  gap: 0.35rem;
}
header .header-auth a,
header .header-auth button,
header [data-header-auth] a,
header [data-header-auth] button {
  white-space: nowrap;
  flex-shrink: 0;
  font-size: 0.75rem;
}
@media (min-width: 640px) {
  header .header-auth a,
  header .header-auth button,
  header [data-header-auth] a,
  header [data-header-auth] button {
    font-size: 0.8125rem;
  }
}


/* === header-auth-btn overflow === */
.header-auth-btn {
  flex-shrink: 0;
  white-space: nowrap;
  max-width: 100%;
}
header, .site-header {
  overflow-x: clip;
}


/* Spacer under fixed header — JS sets exact height; fallback keeps content clear of header */
.site-header-spacer {
  height: var(--site-header-h, 6.75rem);
  min-height: var(--site-header-h, 6.75rem);
  flex-shrink: 0;
  pointer-events: none;
  overflow: hidden;
  margin: 0;
  padding: 0;
  border: 0;
  width: 100%;
}
.admin-panel-shell .admin-tabs-strip,
.seller-panel-shell .seller-tabs-strip {
  top: var(--site-header-h, 6.75rem) !important;
}
.plp-shell,
.pdp-shell,
.cart-page-shell,
.checkout-page-shell,
.sellers-list-shell,
.static-page-shell {
  position: relative;
  z-index: 1;
}
/* پنل‌ها: بدون z-index پایین — وگرنه site-modal زیر هدر (z-100) می‌ماند */
.seller-panel-shell,
.admin-panel-shell,
.profile-page-shell,
.profile-panel-shell {
  position: relative;
  z-index: auto;
}
nav[aria-label="breadcrumb"] {
  position: relative;
  z-index: 10;
  margin-top: 0 !important;
  margin-bottom: 0 !important;
}
/* Keyboard / focus: no black gap under mobile chrome */
html { background-color: var(--pm-bg, #f5f5f7); }
html:not() { background-color: var(--pm-bg, #0a0a0a); }
body {
  background-color: var(--pm-bg, #f5f5f7);
  min-height: 100%;
  min-height: 100dvh;
}
html:not() body { background-color: var(--pm-bg, #0a0a0a); }
input, textarea, select { scroll-margin: 0; }


/* ========== C1–C3: UI polish — colors, mobile, panels ========== */

/* C2: prevent iOS zoom on focus (inputs < 16px zoom the page) */
@media (max-width: 639px) {
  input:not([type="checkbox"]):not([type="radio"]):not([type="range"]),
  select,
  textarea {
    font-size: 16px !important;
  }
}

/* C2: larger touch targets for primary actions on coarse pointers */
@media (pointer: coarse) {
  button.rounded-xl,
  button.rounded-2xl,
  a.rounded-xl,
  a.rounded-2xl {
    min-height: 44px;
  }
  .header-icon-btn,
  .site-header button,
  .site-header a[aria-label] {
    min-width: 44px;
    min-height: 44px;
  }
}

/* C2: safe areas for fixed header / bottom UI */
.site-header,
header.site-header {
  padding-top: env(safe-area-inset-top, 0px);
}
.safe-area-pt {
  padding-top: max(0.5rem, env(safe-area-inset-top, 0px));
}
.safe-area-inset {
  padding-left: max(0.75rem, env(safe-area-inset-left, 0px));
  padding-right: max(0.75rem, env(safe-area-inset-right, 0px));
  padding-bottom: max(0.75rem, env(safe-area-inset-bottom, 0px));
}

/* C3: panel tab strips scroll cleanly on mobile */
/* لبه محو روی موبایل — ۲ تب کامل + لبه تب سوم */
@media (max-width: 767px) {
  .profile-tabs-outer {
    overflow: hidden;
  }
  .profile-tabs-strip {
    /* بدون mask قوی روی خود دکمه‌ها — overlay جدا در JSX */
    scroll-padding-inline: 0.5rem;
  }
  .profile-tabs-fade {
    z-index: 2;
  }
}


.admin-panel-shell .admin-tabs-strip,
.seller-panel-shell .seller-tabs-strip,
.profile-tabs-strip {
  overflow-x: auto;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  overscroll-behavior: contain;
  scrollbar-width: thin;
  scrollbar-color: #c4c4c4 transparent;
}
html:not() .admin-panel-shell .admin-tabs-strip,
html:not() .seller-panel-shell .seller-tabs-strip,
html:not() .profile-tabs-strip {
  scrollbar-color: #666 transparent;
}
/* موبایل افقی: اسکرول‌بار نازک بماند؛ دسکتاپ عمودی دیده شود */
@media (min-width: 768px) {
  .admin-panel-shell .admin-tabs-strip,
  .seller-panel-shell .seller-tabs-strip {
    overflow-x: hidden;
    overflow-y: auto;
    max-height: calc(100vh - 7rem);
  }
}
.admin-panel-shell .admin-tabs-strip::-webkit-scrollbar,
.seller-panel-shell .seller-tabs-strip::-webkit-scrollbar,
.profile-tabs-strip::-webkit-scrollbar {
  width: 8px;
  height: 6px;
}
.admin-panel-shell .admin-tabs-strip::-webkit-scrollbar-thumb,
.seller-panel-shell .seller-tabs-strip::-webkit-scrollbar-thumb,
.profile-tabs-strip::-webkit-scrollbar-thumb {
  background: #c4c4c4;
  border-radius: 8px;
}
html:not() .admin-panel-shell .admin-tabs-strip::-webkit-scrollbar-thumb,
html:not() .seller-panel-shell .seller-tabs-strip::-webkit-scrollbar-thumb {
  background: #666;
}

/* C3: پنل‌ها هم‌عرض خریدار — بدون padding اضافه روی شِل (فقط panel-content-wrap: px-2) */
@media (max-width: 639px) {
  .admin-panel-shell,
  .seller-panel-shell,
  .profile-page-shell,
  .profile-panel-shell {
    padding-left: 0;
    padding-right: 0;
  }
}

/* C1: consistent accent on primary CTA in light mode */
html:not() .btn-primary,
html:not() button.btn-primary {
  background-color: #13ABC4;
  color: #fff;
  -webkit-text-fill-color: #fff;
}
html:not() .btn-primary:hover,
html:not() button.btn-primary:hover {
  background-color: #012536;
}
html:not() .btn-primary,
html:not() button.btn-primary {
  background-color: #13ABC4;
  color: #0a0a0a;
  -webkit-text-fill-color: #0a0a0a;
}

/* C2: product cards — avoid overflow clipping on mobile carousels */
@media (max-width: 639px) {
  .product-card {
    contain-intrinsic-size: 280px 360px;
  }
}

/* C3: modal bottom sheet handle affordance on mobile */
@media (max-width: 639px) {
  .site-modal-panel::before,
  .site-modal-root > div:not(.site-modal-backdrop):not([class*="inset-0"])::before {
    content: "";
    display: block;
    width: 2.5rem;
    height: 0.25rem;
    margin: 0.5rem auto 0.75rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--pm-fg, #252525) 22%, transparent);
    flex-shrink: 0;
  }
  html:not() .site-modal-panel::before,
  html:not() .site-modal-root > div:not(.site-modal-backdrop):not([class*="inset-0"])::before {
    background: color-mix(in srgb, var(--pm-fg, #EBFFFB) 28%, transparent);
  }
}


