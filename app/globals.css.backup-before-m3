.bg-apple-blue, button.bg-apple-blue, a.bg-apple-blue, [class*="bg-apple-blue"],
.bg-\[#13ABC4\], button.bg-\[#13ABC4\], a.bg-\[#13ABC4\],
 .bg-apple-blue,  button.bg-apple-blue,  a.bg-apple-blue,
 .bg-\[#13ABC4\],  button.bg-\[#13ABC4\],  a.bg-\[#13ABC4\] {
  color: #FFFFFF !important;
  -webkit-text-fill-color: #FFFFFF !important;
}
.bg-apple-blue:hover, button.bg-apple-blue:hover, a.bg-apple-blue:hover, [class*="bg-apple-blue"]:hover,
.bg-\[#13ABC4\]:hover, button.bg-\[#13ABC4\]:hover, a.bg-\[#13ABC4\]:hover,
 .bg-apple-blue:hover,  button.bg-apple-blue:hover,  a.bg-apple-blue:hover,  [class*="bg-apple-blue"]:hover {
  background-color: #3161A3 !important;
  color: #FFFFFF !important;
  -webkit-text-fill-color: #FFFFFF !important;
}


/* ux-minbar-a11y-v1 */
.skip-to-main {
  position: absolute;
  top: -100px;
  right: 12px;
  z-index: 9999;
  padding: 0.6rem 1rem;
  border-radius: 999px;
  background: #111;
  color: #fff;
  font-size: 0.8125rem;
  font-weight: 700;
}
.skip-to-main:focus {
  top: 12px;
  outline: 2px solid #13ABC4;
  outline-offset: 2px;
}
:focus-visible {
  outline: 2px solid #13ABC4;
  outline-offset: 2px;
}
html:not() :focus-visible {
  outline-color: #2563eb;
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

