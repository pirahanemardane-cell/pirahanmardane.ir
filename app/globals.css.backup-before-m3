/* === PANEL UI SYSTEM (visual only — no logic) === */
/*
 * ظاهر از dashboard-sidebar (shadcn-like):
 * bg-card/50, border-border/50, active = black/5 | white/10,
 * text 13px, rounded-[6px], muted-foreground
 * فونت: همان فونت سایت (ارث‌بری) — منطق پنل دست‌نخورده
 */

.panel-ui {
  --p-bg: hsl(0 0% 98%);
  --p-card: hsl(0 0% 100%);
  --p-card-50: color-mix(in srgb, hsl(0 0% 100%) 50%, transparent);
  --p-border: color-mix(in srgb, hsl(240 5.9% 90%) 50%, transparent);
  --p-border-solid: hsl(240 5.9% 90%);
  --p-fg: hsl(240 10% 3.9%);
  --p-muted: hsl(240 3.8% 46.1%);
  --p-muted-50: color-mix(in srgb, hsl(240 3.8% 46.1%) 50%, transparent);
  --p-muted-70: color-mix(in srgb, hsl(240 3.8% 46.1%) 70%, transparent);
  --p-hover: rgba(0, 0, 0, 0.05);
  --p-active: rgba(0, 0, 0, 0.05);
  --p-content-tint: rgba(0, 0, 0, 0.02);
  --p-primary: hsl(240 5.9% 10%);
  --p-primary-fg: hsl(0 0% 98%);
  --p-primary-10: color-mix(in srgb, hsl(240 5.9% 10%) 10%, transparent);
  --p-radius: 0.75rem;
  --p-radius-nav: 6px;
  --p-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);
  --p-ring: 0 0 0 1px rgba(0, 0, 0, 0.05);
  background: var(--p-bg);
  color: var(--p-fg);
  /* فونت خانوادهٔ سایت حفظ می‌شود */
}

html:not() .panel-ui {
  --p-bg: hsl(240 10% 3.9%);
  --p-card: hsl(240 10% 3.9%);
  --p-card-50: color-mix(in srgb, hsl(240 10% 8%) 50%, transparent);
  --p-border: color-mix(in srgb, hsl(240 3.7% 15.9%) 50%, transparent);
  --p-border-solid: hsl(240 3.7% 15.9%);
  --p-fg: hsl(0 0% 98%);
  --p-muted: hsl(240 5% 64.9%);
  --p-muted-50: color-mix(in srgb, hsl(240 5% 64.9%) 50%, transparent);
  --p-muted-70: color-mix(in srgb, hsl(240 5% 64.9%) 70%, transparent);
  --p-hover: rgba(255, 255, 255, 0.05);
  --p-active: rgba(255, 255, 255, 0.10);
  --p-content-tint: rgba(255, 255, 255, 0.02);
  --p-primary: hsl(0 0% 98%);
  --p-primary-fg: hsl(240 5.9% 10%);
  --p-primary-10: color-mix(in srgb, hsl(0 0% 98%) 10%, transparent);
  --p-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.35);
  --p-ring: 0 0 0 1px rgba(255, 255, 255, 0.05);
  background: var(--p-bg);
