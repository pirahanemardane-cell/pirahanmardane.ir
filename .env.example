# =============================================================================
# پیراهن مردانه — https://pirahanemardane.ir
# Production env template (Vercel / host)
# هرگز SERVICE_ROLE یا رمزها را در کلاینت commit نکنید
# =============================================================================

# دامنه عمومی سایت (بدون اسلش انتهایی)
NEXT_PUBLIC_SITE_URL=https://pirahanemardane.ir

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# فقط سرور — در Vercel به‌عنوان Encrypted / Sensitive
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ---------- پرداخت ----------
# فعلاً mock؛ وقتی Merchant ID آماده شد مقدار بگذار و PAYMENT_MOCK=false
PAYMENT_MOCK=true
# ZARINPAL_MERCHANT_ID=
# Callback پیشنهادی: ${NEXT_PUBLIC_SITE_URL}/api/payments/verify

# تا تأیید پترن: mock
# MELI_USERNAME=
# MELI_PASSWORD=
# MELI_FROM=

# ---------- اختیاری ----------
# NODE_ENV=production

# ---------- امنیت ----------
# شماره‌های ادمین (کاما جدا)
ADMIN_PHONES=09XXXXXXXXX
# پروداکشن: حتما false
# فقط dev: نمایش کد در پاسخ API

# OTP / Melipayamak
OTP_MOCK=true
# OTP_DEBUG=1
# MELLI_USERNAME=
# MELLI_PASSWORD=
# MELLI_PATTERN_CODE=
# SMS_PATTERN_OTP_LOGIN=

# عمر سشن ادمین (ثانیه) — پیش‌فرض ۲ ساعت = 7200
ADMIN_SESSION_MAX_AGE_SEC=7200

# ---------- Rate Limit (اختیاری ولی توصیه‌شده) ----------
# اگر Upstash نباشد، از جدول Supabase یا حافظه استفاده می‌شود
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# هرگز در production این را true نگذارید:
# RATE_LIMIT_DISABLED=false
